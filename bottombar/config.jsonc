{
	"include": [
		"~/.config/waybar/bottombar/modules/hyprland/workspaces.jsonc",
		"~/.config/waybar/bottombar/modules/temperature.jsonc",
		"~/.config/waybar/bottombar/modules/memory.jsonc",
		"~/.config/waybar/bottombar/modules/cpu.jsonc",
		"~/.config/waybar/bottombar/modules/custom/distro.jsonc",
		"~/.config/waybar/bottombar/modules/idle_inhibitor.jsonc",
		"~/.config/waybar/bottombar/modules/clock.jsonc",
		"~/.config/waybar/bottombar/modules/network.jsonc",
		"~/.config/waybar/bottombar/modules/bluetooth.jsonc",
		"~/.config/waybar/bottombar/modules/custom/system_update.jsonc",
		"~/.config/waybar/bottombar/modules/hyprland/language.jsonc",
		"~/.config/waybar/bottombar/modules/pulseaudio.jsonc",
		"~/.config/waybar/bottombar/modules/backlight.jsonc",
		"~/.config/waybar/bottombar/modules/custom/dividers.jsonc",
		"~/.config/waybar/bottombar/modules/custom/cpu_frequency.jsonc"
	],

	/*------------
	    layout
	------------*/

	"modules-left": [
		"group/user",
		"custom/left_div#1",
		"hyprland/workspaces",
		"custom/right_div#1"
	],
	"modules-center": [
		"custom/left_div#1",
		"temperature#gpu",
		"temperature#cpu",
		"custom/left_div#3",
		"cpu",
		"custom/cpu-frequency",
		"custom/left_div#4",
		"memory",
		"custom/left_inv#1",
		"custom/left_div#5",
		"custom/distro",
		"custom/right_div#2",
		"custom/right_inv#1",
		"idle_inhibitor",
		"clock#time",
		"custom/right_div#3",
		"clock#date",
		"custom/right_div#4",
		"network",
		"bluetooth",
		"custom/system_update",
		"custom/right_div#5"
	],
	"modules-right": [
		"hyprland/language",
		"custom/left_div#6",
		"group/pulseaudio",
		"custom/left_div#7",
		"backlight"
	],

	/*-------------
	    options
	-------------*/

	// "expand-center":
	// "expand-left":
	// "expand-right":
	"layer": "top",
	// "output":
	"position": "bottom",
	"height": 0,
	"width": 0,
	"margin": 0,
	// "margin-top":
	// "margin-left":
	// "margin-bottom":
	// "margin-right":
	// "no-center":
	"spacing": 0,
	// "name":
	"mode": "dock",
	// "start_hidden":
	// "modifier-reset":
	// "exclusive":
	// "fixed-center":
	// "passthrough":
	// "ipc":
	// "id":
	"reload_style_on_change": true
	// "on-sigusr1":
	// "on-sigusr2":
}
