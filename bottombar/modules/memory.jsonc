{
	"memory": {
		"interval": 1,
		"format": "󰘚 {used:0.1f}/{total:0.1f} GB",
		"format-warning": "󰀧 {used:0.1f}/{total:0.1f} GB",
		"format-critical": "󰀧 {used:0.1f}/{total:0.1f} GB",
		// "format-icons":
		// "rotate":
		"states": {
			"warning": 75,
			"critical": 90
		},
		"min-length": 13,
		"max-length": 13,
		// "align":
		// "justify":
		// "on-click":
		"on-click": "hyprctl clients | grep -q 'class: btop-waybar' && pkill -f 'btop -p 3' || kitty --class btop-waybar -e btop -p 3",
		// "on-click-middle":
		// "on-click-right":
		// "on-update":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "Swap: {swapUsed:0.2f}/{swapTotal:0.2f}"
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":

		// "format": "󰘚 {percentage}%",
		// "tooltip-format": "Memory Used: {used:0.00f}/{total:0.00f} GB"
	}
}
