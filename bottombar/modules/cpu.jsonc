{
	"cpu": {
		"interval": 1,
		"format": "󰍛 {usage}%",
		"format-warning": "󰀨 {usage}%",
		"format-critical": "󰀨 {usage}%",
		// "format-icons":
		"min-length": 6,
		"max-length": 6,
		// "align":
		// "justify":
		// "rotate":
		"states": {
			"warning": 75,
			"critical": 90
		},
		//"on-click": "exec kitty -e --class \"btop-cpu\" btop -p 2",
		"on-click": "hyprctl clients | grep -q 'class: btop-waybar' && pkill -f 'btop -p 2' || kitty --class btop-waybar -e btop -p 2",
		// "on-click-middle":
		// "on-update":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		//"tooltip": false,
		"tooltip-format": "{max_frequency} GHz"
		// "expand":
	}
}
