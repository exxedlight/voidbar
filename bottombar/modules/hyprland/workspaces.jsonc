{
	"hyprland/workspaces": {
		//"format": "<span size='7pt' fgalpha='30%'>{name}</span>{windows}", //  {icon}- {name}-1 {windows}-winIcons
		"format": "{windows}",
		"format-window-separator": " ",
		"window-rewrite-default": "",
		"window-rewrite": {
			"title<.*youtube.*>": "",
			"class<firefox>": "",
			"class<firefox> title<.*github.*>": "",
			"foot": "",
			"code": "󰨞",
			"kitty": "",
			"vivaldi": "",
			"Audacious": "󰐍",
			"deadbeef": "󰐍",
			"thunar": "",
			"telegram": "",
			"lutris": "",
			"class<.*.exe>": "",
			"draw.io": "",
			"mpv": "",
			"nomacs": "",
			"subl": "",
			"onlyoffice": "",
			"libreoffice-writer": "",
			"steam": "",
			"org.qbittorrent.qBittorrent": "󰰩",
			"org.gnome.FileRoller": "",
			"zen": "",
			"class<.*calculator.*>": "󰃬",
			"class<tk> title<.*adb.*>": "",
			"com.exx.quickdesktop": "",
			"class<btop.*>": "󰙭",
			"Postman": "󱂛",
			"Anydesk": "",
			"class<VirtualBox.*>": ""
		},
		"format-icons": {
			//"active": "",
			"default": ""
		},
		"persistent-workspaces": {
			"*": 10
		},
		"on-scroll-up": "hyprctl dispatch workspace -1",
		"on-scroll-down": "hyprctl dispatch workspace +1",
		"cursor": false
	}
}
