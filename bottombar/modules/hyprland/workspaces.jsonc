{
  "hyprland/workspaces": {
    //"format": "<span size='7pt' fgalpha='30%'>{name}</span>{windows}", //  {icon}- {name}-1 {windows}-winIcons
    "format": "{windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "title<.*youtube.*>": "",
      "class<firefox|zen>": "",
      "class<firefox> title<.*github.*>": "",
      "class<code|dev.zed.Zed>": "󰨞",
      "class<.*.exe>": "",
      "kitty": "",
      "vivaldi": "",
      "Audacious|deadbeef": "󰐍",
      "thunar": "",
      "telegram": "",
      "lutris": "",
      "draw.io": "",
      "mpv": "",
      "nomacs": "",
      "subl": "",
      "onlyoffice": "",
      "libreoffice-writer": "",
      "steam": "",
      "org.qbittorrent.qBittorrent": "󰰩",
      "org.gnome.FileRoller": "",
      "class<.*calculator.*>": "󰃬",
      "class<tk> title<.*adb.*>": "",
      "com.exx.quickdesktop": "",
      "class<btop.*>": "󰙭",
      "Postman": "󱂛",
      "Anydesk": "",
      "class<VirtualBox.*>": "",
      "krita": "",
      "sai2.exe": "",
      "qpdfview.local.qpdfview": "",
      "unityhub|Unity": "",
      "com.gabm.satty": "󱣙",
      "Mysql-workbench-bin": "",
      "pavucontrol": "󰕾"
    },
    "format-icons": {
      //"active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 10
    },
    //"on-scroll-up": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"-1\" }))'",
    //"on-scroll-down": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"+1\" }))'",
    "on-scroll-up": "",
    "cursor": false
    //"on-click-window": "~/.config/waybar/scripts/hyprland-workspace-click.sh {address} {button}"
  }
}
