{
	"clock#time": {
		"interval": 1,
		"format": "{:%H:%M:%S}",
		// "timezone":
		// "timezones":
		//"locale": "ru_UA.UTF-8",
		"min-length": 10,
		"max-length": 10,
		// "rotate": 0,
		// "on-click":
		// "on-click-middle":
		// "on-click-right":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "<span text_transform='lowercase'>{:%I:%M %p}</span>"
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
	},

	/*--------------
	    calendar
	--------------*/

	"clock#date": {
		// "interval":
		"format": "󰸗 {:%d.%m %a}",
		// "timezone":
		// "timezones":
		//"locale": "en_US.UTF-8",
		"min-length": 12,
		"max-length": 12,
		// "rotate":
		// "on-click":
		// "on-click-middle":
		// "on-click-right":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "{calendar}",
		// "menu":
		// "menu-file":
		// "menu-actions":
		// "expand":
		"calendar": {
			"mode": "month",
			"mode-mon-col": 6,
			// "week-pos":
			// "on-scroll":
			"format": {
				"months": "<span alpha='100%'><b>{}</b></span>",
				"days": "<span alpha='90%'>{}</span>",
				// "weeks":
				"weekdays": "<span alpha='80%'><i>{}</i></span>",
				"today": "<span alpha='100%'><b><u>{}</u></b></span>"
			}
		},
		"actions": {
			"on-click": "mode"
			// "on-click-middle":
			// "on-click-right":
			// "on-scroll-up":
			// "on-scroll-down":
		}
	}
}
