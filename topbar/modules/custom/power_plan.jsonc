{
    "custom/power-plan-eco": {
        "exec": "~/.config/waybar/scripts/power-status.sh eco",
        "on-click": "~/.config/waybar/scripts/power-plan-change.sh eco",
        "format": "",
        "return-type": "json",
        "tooltip-format": "Power-Saver",
        "min-length": 2,
        "max-length": 2,
        "interval": 1
    },
    "custom/power-plan-balanced": {
        "exec": "~/.config/waybar/scripts/power-status.sh balanced",
        "on-click": "~/.config/waybar/scripts/power-plan-change.sh balanced",
        "format": "󰾅",
        "return-type": "json",
        "tooltip-format": "Balanced",
        "min-length": 2,
        "max-length": 2,
        "interval": 1
    },
    "custom/power-plan-performance": {
        "exec": "~/.config/waybar/scripts/power-status.sh performance",
        "on-click": "~/.config/waybar/scripts/power-plan-change.sh performance",
        "format": "󱐌", //  
        "return-type": "json",
        "tooltip-format": "Max Performance",
        "min-length": 2,
        "max-length": 2,
        "interval": 1
    },
    "custom/hypridle": {
        "exec": "~/.config/waybar/scripts/hypridle-status.sh",
        "on-click": "~/.config/waybar/scripts/hypridle-toogle.sh",
        "format": "{icon}",
        "format-icons": {
            "active": "󱫔",
            "disabled": "󱎬"
        },
        "return-type": "json",
        "interval": 2,
        "min-length": 2,
        "max-length": 2,
        "tooltip-format": "Hypridle {text}"
    },
    "custom/ultrasaver": {
        "exec":"~/.config/waybar/scripts/ultrasaver-status.sh",
        "on-click": "~/.config/waybar/scripts/ultrasaver-toogle.sh",
        "interval": 1,
        "return-type": "json",
        "format": "󱈑",
        "min-length": 3,
        "max-length": 3,
        "tooltip-format": "Ultra power saver"
    }
}