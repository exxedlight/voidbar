{
  "custom/mpris-text": {
    //  '&' protection
    "exec": "playerctl metadata --format '{{title}} - {{artist}}' --player=audacious | sed 's/\\&/\\&amp;/g'",
    //"exec": "audtool current-song",
    "interval": 1,
    "min-length": 35,
    "max-length": 35,
    "markup": false,

    // --> left click toogle
    "on-click": "hyprctl clients -j | jq -e '.[] | select(.class == \"Audacious\" and (.title | test(\".* - Audacious$\")) and .mapped)' >/dev/null && audtool mainwin-show off || audtool mainwin-show on", 
    "on-click-right": "audtool mainwin-show off",
    "on-click-middle": "killall -9 audacious",
  },
}
