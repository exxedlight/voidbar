{
    "custom/cava": {
        "exec": "sleep 3 && cava -p ~/.config/waybar/modules/custom/cava.conf | sed -u 's/;//g'",
        //"exec": "sleep 1 && stdbuf -oL cava -p ~/.config/waybar/modules/custom/cava.conf | sed -u 's/;//g'",
        "min-length": 16,
        "max-length": 16,
        //"input_delay": 5,
        //"on-click": "playerctl next",
        //"on-click-right": "playerctl previous",
        "tooltip": false,
        "on-click-middle": "audacious",
        "on-scroll-up": "playerctl volume 0.05+",
		"on-scroll-down": "playerctl volume 0.05-"
    }
}