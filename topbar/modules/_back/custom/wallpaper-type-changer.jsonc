{
    "custom/wallpaper-type-changer": {
        "exec": "~/.config/waybar/scripts/wallpaper-check.sh",
        "on-click": "~/.config/waybar/scripts/wallpaper-type-change.sh",
        "format": "{icon}",
        "format-icons": {
            "static": "",
            "video": "",
            "none": "󰟢"
        },
        "align": "center",
        "max-height": 1,
        "return-type": "json",
        "interval": 3,
        "tooltip-format": "Wallpaper type toogle"
    }
}