{
    "custom/play-volume": {
        "exec": "echo \"  $(audtool get-volume)%\"",
        "interval": 1
    },
    "custom/play-count": {
        "exec": "~/.config/waybar/scripts/audacious-count.sh",
        "min-length": 8,
        "max-length": 8,
        "interval": 3
    },
    "custom/player-list-button": {
        "on-click": "audtool jumptofile-show",
        "format": "󱎸",//"󰲸",
        "min-length": 3,
        "max-length": 3,
        "tooltip-format": "Playlist"
    },
    "custom/player-progress": {
        "format": " "
    }
}